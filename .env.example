PORT=4000
# MongoDB Atlas SRV URI; URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/student_gateway?retryWrites=true&w=majority&appName=StudentGateway
# API tests use a separate database whose name must end in "_test".
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Generate a random secret of at least 32 characters. Keep it server-side; never expose it to the frontend.
ADMIN_APPROVAL_TOKEN=
# Enable only for a clearly labeled local demo; see README before using.
DEMO_MODE=false
GATE_DEVICE_TOKEN=replace-with-a-separate-long-random-secret
# For local development, use: mongodb://127.0.0.1:27017/student_gateway
# API tests require a separate database whose name ends in "_test".
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/student_gateway_test
